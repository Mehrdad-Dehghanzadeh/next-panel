{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@app/*": ["./src/app/*"],
      "@utils/*": ["./src/utils/*"],
      "@utils": ["./src/utils"],
      "@ts/*": ["./src/ts/*"],
      "@UIKits": ["./src/components/UIKits"],
      "@UIKits/*": ["./src/components/UIKits/*"],
      "@Roots": ["./src/components/Roots"],
      "@Roots/*": ["./src/components/Roots/*"],
      "@styles/*": ["./src/styles/*"],
      "@styles": ["./src/styles"],
      "@hooks/*": ["./src/hooks/*"],
      "@hooks": ["./src/hooks"],
      "@assets/*": ["./src/assets/*"],
      "@assets": ["./src/assets"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
